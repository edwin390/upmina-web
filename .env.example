# =====================================================
# UPMINA Web — Variables de Entorno
# Copia este archivo a .env y rellena con tus valores
# =====================================================

# ---------- Twitch ----------
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_CHANNEL=upminaa

# ---------- YouTube ----------
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=

# ---------- Instagram ----------
# App de Meta para "Instagram API with Instagram Login" (Business Login), usada por
# /api/instagram-auth y /api/instagram-callback para autorizar la cuenta y guardar la
# conexión en Supabase (provider = 'instagram' en social_connections). Ambas SOLO servidor
# (nunca con prefijo VITE_). INSTAGRAM_APP_ID no es secreto por sí mismo, pero tampoco
# necesita llegar al navegador: todo el intercambio ocurre en las dos rutas anteriores.
# INSTAGRAM_APP_SECRET SÍ es secreto: firma el `state` anti-CSRF y se usa en el intercambio
# del authorization code y en la conversión a token de larga duración. El OAuth solo se
# permite cuando VERCEL_ENV = 'production' (Preview responde 403 sin contactar a Meta).
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# Token de acceso (Instagram API con Instagram Login) de la cuenta profesional. Solo servidor.
# FALLBACK TEMPORAL mientras no exista una conexión OAuth guardada (o mientras se valida la
# de arriba): el código usa antes la fila provider = 'instagram' de la tabla
# social_connections (Supabase) y solo recurre a esta variable si esa fila no existe,
# Supabase no está configurado o falla su lectura. Si la fila existe pero está caducada NO se
# usa esta variable: la API responde 503. Se eliminará cuando el OAuth, la persistencia y la
# renovación estén validados en producción.
# Scopes que usa el código: instagram_business_basic (feed, perfil y elementos de carrusel) e
# instagram_business_manage_comments (lectura de comentarios; sin él solo se ofrece el enlace a
# Instagram). Es un token de larga duración (~60 días) que hoy se pega y renueva A MANO: cuando
# caduca, el feed responde 502. El código consulta la cuenta del token (/me): no usa ninguna
# variable con el id de usuario.
INSTAGRAM_ACCESS_TOKEN=

# ---------- TikTok ----------
# Los tokens (access/refresh) NO van en variables de entorno: se obtienen con /api/tiktok-auth
# y se guardan y refrescan automáticamente en Supabase (tabla social_connections).
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# ---------- Supabase ----------
# Déjalos vacíos para desactivar Community; con valores no vacíos la app intenta conectarse a Supabase.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# SOLO servidor (nunca con prefijo VITE_). La usan el OAuth y el feed de TikTok (callback y refresh) para guardar
# y leer tokens en la tabla social_connections, y la persistencia de Instagram para leer su conexión
# (junto con VITE_SUPABASE_URL). Omite RLS.
SUPABASE_SERVICE_ROLE_KEY=

# ---------- App ----------
VITE_APP_URL=http://localhost:3000
# VITE_DEMO_MODE=true fuerza datos mock en Twitch/YouTube/Instagram/TikTok sin llamar a sus APIs reales.
VITE_DEMO_MODE=false
